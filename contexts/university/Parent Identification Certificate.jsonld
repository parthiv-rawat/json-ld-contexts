{
    "@context": {
        "@version": 1.1,
        "@protected": true,

        "id": "@id",
        "type": "@type",
        "name": "http://schema.org/name",
        "description": "http://schema.org/description",
        "identifier": "http://schema.org/identifier",
        "design": "https://example.org/vocab#design",
        "orientation": "https://example.org/vocab#orientation",

        "ParentIdentificationCertificate": {
            "@id": "https://parthiv-rawat.github.io/json-ld-contexts/contexts/university/ParentIdentificationCertificate",
            "@context": {
                "@version": 1.1,
                "@protected": true,
                "id": "@id",
                "type": "@type",
                "name": "http://schema.org/name",
                "design": "https://example.org/vocab#design",
                "orientation": "https://example.org/vocab#orientation",
                "identifier": "http://schema.org/identifier",
                "description": "http://schema.org/description"
            }
        },

        "ParentIdentificationCertificateInformation": {
            "@id": "https://parthiv-rawat.github.io/json-ld-contexts/contexts/university/ParentIdentificationInformation",
            "@context": {
                "@version": 1.1,
                "@protected": true,
                "id": "@id",
                "type": "@type",
                "parentName": "https://example.org/vocab#parentName",
                "relationship": "https://example.org/vocab#relationship",
                "dateOfBirth": "http://schema.org/birthDate",
                "gender": "https://example.org/vocab#gender",
                "nationality": "https://example.org/vocab#nationality",
                "photo": "http://schema.org/image",
                "contactNumber": "https://example.org/vocab#contactNumber",
                "email": "http://schema.org/email",
                
                "linkedStudent": {
                    "@id": "https://parthiv-rawat.github.io/json-ld-contexts/contexts/university/LinkedStudentInformation",
                    "@context": {
                        "@version": 1.1,
                        "@protected": true,
                        "studentId": "@id",
                        "studentName": "http://schema.org/name",
                        "enrollmentID": "https://example.org/vocab#enrollmentID"
                    }
                }
            }
        }
    }
}
